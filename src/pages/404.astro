---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Halaman Tidak Ditemukan | Faqih Ahmadineza" description="Halaman yang Anda cari tidak ditemukan.">
  <section class="section-shell py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.22em] text-red-500">404</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-white sm:text-5xl">Halaman tidak ditemukan</h1>
      <p class="mt-5 text-lg text-muted">
        Link yang Anda buka mungkin sudah berpindah atau tidak tersedia. Kembali ke halaman utama untuk melihat portofolio saya.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a href="/" class="inline-flex items-center justify-center rounded-full bg-red-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-red-500">
          Kembali ke Beranda
        </a>
      </div>
    </div>
  </section>
</Layout>
