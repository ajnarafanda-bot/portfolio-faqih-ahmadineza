---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Faqih Ahmadineza`} description={project.description}>
  <section class="section-shell py-16 lg:py-20">
    <div class="mb-8">
      <a href="/projects" class="text-sm font-semibold text-primary hover:text-white">← Kembali ke project</a>
    </div>

    <article class="surface-card overflow-hidden">
      <div class="h-72 border-b border-white/8 bg-[radial-gradient(circle_at_top_left,_rgba(200,16,46,0.18),_transparent_40%),linear-gradient(135deg,#1c1215,#151011)]"></div>
      <div class="space-y-8 p-6 sm:p-8 lg:p-10">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-[0.65rem] font-medium uppercase tracking-[0.18em] text-primary">{project.category}</p>
            <h1 class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">{project.title}</h1>
          </div>
          <div class="flex gap-3">
            {project.demo ? <a href={project.demo} class="inline-flex items-center justify-center rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white">Demo</a> : null}
            {project.repo ? <a href={project.repo} class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white">Repository</a> : null}
          </div>
        </div>

        <p class="max-w-3xl text-lg leading-8 text-muted">{project.description}</p>
        <div class="flex flex-wrap gap-2">
          {project.stack.map((item) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-muted">{item}</span>
          ))}
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
          <div>
            <h2 class="text-xl font-bold text-white">Hasil yang dicapai</h2>
            <p class="mt-3 text-base leading-7 text-muted">{project.result}</p>
          </div>
          <div>
            <h2 class="text-xl font-bold text-white">Fitur utama</h2>
            <ul class="mt-3 space-y-3 text-muted">
              {project.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-primary"></span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </article>
  </section>
</Layout>
