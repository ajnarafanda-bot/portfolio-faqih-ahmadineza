---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/site';
---

<Layout title="Projects | Faqih Ahmadineza" description="Project showcase Faqih Ahmadineza.">
  <section class="section-shell py-16 lg:py-20">
    <div class="mb-10 text-center">
      <p class="section-kicker inline-flex">Projects</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-white sm:text-5xl">Project Showcase</h1>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      {projects.map((project) => (
        <article class="surface-card overflow-hidden">
          <div class="h-52 border-b border-white/8 bg-[radial-gradient(circle_at_top_left,_rgba(200,16,46,0.18),_transparent_40%),linear-gradient(135deg,#1c1215,#151011)]"></div>
          <div class="space-y-5 p-6">
            <div>
              <p class="text-[0.65rem] font-medium uppercase tracking-[0.18em] text-primary">{project.category}</p>
              <h2 class="mt-2 text-2xl font-bold text-white">{project.title}</h2>
              <p class="mt-3 text-sm leading-7 text-muted">{project.description}</p>
            </div>
            <div class="flex flex-wrap gap-2">
              {project.stack.map((item) => (
                <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[11px] font-medium text-muted">{item}</span>
              ))}
            </div>
            <div class="pt-2">
              <a href={`/projects/${project.slug}`} class="text-sm font-semibold text-primary hover:text-white">Lihat detail →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
