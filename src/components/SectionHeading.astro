---
const { label, title, description } = Astro.props;
---

<div class="mb-10">
  <div class="section-kicker">{label}</div>
  <h2 class="mt-5 max-w-2xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
    {title}
  </h2>
  {description && <p class="mt-4 max-w-2xl text-base leading-7 text-muted">{description}</p>}
</div>
