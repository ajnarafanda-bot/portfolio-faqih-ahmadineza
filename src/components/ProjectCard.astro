---
import Badge from './Badge.astro';

const { project } = Astro.props;
---

<article class="reveal group overflow-hidden rounded-[1.5rem] border border-white/8 bg-surface/90 transition duration-200 hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_0_0_1px_rgba(200,16,46,0.2),0_30px_70px_-35px_rgba(200,16,46,0.8)]">
  <div class="h-52 border-b border-white/8 bg-[radial-gradient(circle_at_top_left,_rgba(200,16,46,0.18),_transparent_40%),linear-gradient(135deg,#1c1215,#151011)] p-4">
    <div class="flex h-full flex-col rounded-2xl border border-white/8 bg-slate-950/60 p-3">
      <div class="mb-3 flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-red-400/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-yellow-400/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
      </div>
      <div class="flex-1 rounded-xl border border-dashed border-white/8 bg-slate-900/70 p-3">
        <div class="h-full rounded-lg border border-white/8 bg-[linear-gradient(120deg,rgba(200,16,46,0.14),transparent)] p-3">
          <div class="mb-3 h-3 w-24 rounded-full bg-white/10"></div>
          <div class="space-y-2">
            <div class="h-2.5 w-full rounded-full bg-white/8"></div>
            <div class="h-2.5 w-11/12 rounded-full bg-white/8"></div>
            <div class="h-2.5 w-9/12 rounded-full bg-white/8"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="space-y-5 p-6">
    <div>
      <div class="mb-3 flex items-center justify-between gap-3">
        <span class="text-[0.65rem] font-medium uppercase tracking-[0.2em] text-primary">{project.category}</span>
        <Badge tone={project.status === 'Tersedia' ? 'blue' : 'learning'}>{project.status}</Badge>
      </div>
      <h3 class="text-2xl font-semibold text-white">{project.title}</h3>
      <p class="mt-3 text-sm leading-7 text-muted">{project.description}</p>
    </div>

    <div class="flex flex-wrap gap-2">
      {project.tech.map((tag) => (
        <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[0.65rem] uppercase tracking-[0.12em] text-muted">{tag}</span>
      ))}
    </div>

    <div class="pt-2">
      <a href={`/projects/${project.slug}`} class="inline-flex items-center gap-2 text-sm font-medium text-primary transition hover:text-white">
        Lihat Detail
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
